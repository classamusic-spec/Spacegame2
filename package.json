    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/three": "^0.165.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  },
  "dependencies": {
    "three": "^0.165.0"
  }
}
