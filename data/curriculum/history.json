      "objective": "I know things change over time.",
      "teach": [
        { "text": "Long ago, life was different. People rode horses instead of cars.", "image": "🐴" },
        { "text": "History is the story of what happened before now.", "example": "Then: candles. Now: light bulbs 💡" }
      ],
      "questions": [
        { "id": "q1", "prompt": "Long ago, how did many people travel?", "answerStyle": "text",
