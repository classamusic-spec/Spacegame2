        { "id": "q2", "prompt": "History is the story of...", "answerStyle": "text",
          "answers": [ {"id":"a","label":"The past","correct":true}, {"id":"b","label":"Tomorrow","correct":false} ] },
        { "id": "q3", "prompt": "Which is from long ago, not now?", "answerStyle": "picture",
          "answers": [ {"id":"a","image":"🕯️","correct":true}, {"id":"b","image":"📱","correct":false} ] }
      ]
    },
