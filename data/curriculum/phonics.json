        { "id": "q3", "prompt": "Which word rhymes with PIG?", "answerStyle": "text",
          "answers": [ {"id":"a","label":"dig","correct":true}, {"id":"b","label":"cup","correct":false}, {"id":"c","label":"top","correct":false} ] }
