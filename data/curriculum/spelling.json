        { "id": "q2", "prompt": "How do you spell ☀️ (sun)?", "answerStyle": "text",
          "answers": [ {"id":"a","label":"SUN","correct":true}, {"id":"b","label":"SNU","correct":false}, {"id":"c","label":"SON","correct":false} ] },
        { "id": "q3", "prompt": "How do you spell 🎩 (hat)?", "answerStyle": "text",
          "answers": [ {"id":"a","label":"HAT","correct":true}, {"id":"b","label":"HTA","correct":false} ] }
      ]
    },
