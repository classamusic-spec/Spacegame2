      "objective": "I can spell simple three-letter words.",
      "teach": [
        { "text": "Many short words have the pattern consonant-vowel-consonant, like c-a-t.", "image": "🐱" },
        { "text": "Sound out each letter to spell it.", "example": "🌞 = S-U-N" }
      ],
      "questions": [
        { "id": "q1", "prompt": "How do you spell 🐱?", "answerStyle": "text",
