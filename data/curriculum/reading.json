{
  "subject": "reading",
  "version": 1,
  "lessons": [
    {
      "id": "reading-tod-pictures", "gradeBand": "toddler", "title": "Pictures Tell Stories",
      "objective": "I can understand pictures in a book.",
      "teach": [
        { "text": "Before we read words, pictures tell us what is happening.", "image": "📖" },
        { "text": "Look at a picture and think: what do you see?", "image": "👀" }
      ],
      "questions": [
        { "id": "q1", "prompt": "Which picture is a dog?", "answerStyle": "picture",
          "answers": [ {"id":"a","image":"🐶","correct":true}, {"id":"b","image":"🚗","correct":false} ] },
        { "id": "q2", "prompt": "Which one is a book?", "answerStyle": "picture",
          "answers": [ {"id":"a","image":"📖","correct":true}, {"id":"b","image":"🍎","correct":false}, {"id":"c","image":"⚽","correct":false} ] },
        { "id": "q3", "prompt": "Which one can you read?", "answerStyle": "picture",
          "answers": [ {"id":"a","image":"📚","correct":true}, {"id":"b","image":"🥶","correct":false} ] }
      ]
    },
    {
      "id": "reading-prek-letters", "gradeBand": "prek", "title": "Letters Make Words",
      "objective": "I know letters build words.",
      "teach": [
        { "text": "Words are made of letters. The alphabet has 26 letters.", "image": "🔤" },
        { "text": "Letters together make words we can read, like C-A-T.", "example": "C + A + T = CAT 🐱" }
      ],
      "questions": [
        { "id": "q1", "prompt": "Which one is a letter?", "answerStyle": "text",
          "answers": [ {"id":"a","label":"B","correct":true}, {"id":"b","label":"7","correct":false}, {"id":"c","label":"#","correct":false} ] },
        { "id": "q2", "prompt": "How many letters are in the word CAT?", "answerStyle": "number",
          "answers": [ {"id":"a","label":"3","correct":true}, {"id":"b","label":"2","correct":false}, {"id":"c","label":"4","correct":false} ] },
        { "id": "q3", "prompt": "Which is the first letter of the alphabet?", "answerStyle": "text",
          "answers": [ {"id":"a","label":"A","correct":true}, {"id":"b","label":"Z","correct":false} ] }
      ]
    },
    {
      "id": "reading-k-sightwords", "gradeBand": "k", "title": "Sight Words",
      "objective": "I can read common sight words.",
      "teach": [
        { "text": "Sight words are little words we see a lot, like 'the', 'and', 'is'.", "image": "👁️" },
        { "text": "We learn them by sight so reading is faster.", "example": "The dog is big." }
      ],
      "questions": [
        { "id": "q1", "prompt": "Which is a real sight word?", "answerStyle": "text",
          "answers": [ {"id":"a","label":"the","correct":true}, {"id":"b","label":"zix","correct":false}, {"id":"c","label":"qop","correct":false} ] },
        { "id": "q2", "prompt": "Finish it: I ___ a cat.", "answerStyle": "text",
          "answers": [ {"id":"a","label":"see","correct":true}, {"id":"b","label":"sea","correct":false}, {"id":"c","label":"say","correct":false} ] },
        { "id": "q3", "prompt": "Which word is 'and'?", "answerStyle": "text",
          "answers": [ {"id":"a","label":"and","correct":true}, {"id":"b","label":"end","correct":false}, {"id":"c","label":"ant","correct":false} ] }
      ]
    },
    {
      "id": "reading-g1-details", "gradeBand": "g1", "title": "Story Details",
      "objective": "I can find who and what in a story.",
      "teach": [
        { "text": "A story has characters (who) and events (what happens).", "image": "📖" },
        { "text": "Read: 'Sam ran to the park with his red ball.' Sam is who; he ran is what.", "example": "Who? Sam. What? Ran to the park." }
      ],
      "questions": [
        { "id": "q1", "prompt": "Read: 'Mia fed her cat.' Who is in the story?", "answerStyle": "text",
          "answers": [ {"id":"a","label":"Mia","correct":true}, {"id":"b","label":"A bus","correct":false}, {"id":"c","label":"The sun","correct":false} ] },
        { "id": "q2", "prompt": "Read: 'The dog dug a hole.' What did the dog do?", "answerStyle": "text",
          "answers": [ {"id":"a","label":"Dug a hole","correct":true}, {"id":"b","label":"Went to school","correct":false} ] },
        { "id": "q3", "prompt": "Read: 'Sam ran with his red ball.' What color is the ball?", "answerStyle": "text",
          "answers": [ {"id":"a","label":"Red","correct":true}, {"id":"b","label":"Blue","correct":false}, {"id":"c","label":"Green","correct":false} ] }
      ]
    },
    {
      "id": "reading-g2-sequence", "gradeBand": "g2", "title": "Beginning, Middle, End",
      "objective": "I can put a story in order.",
      "teach": [
        { "text": "Stories happen in order: a beginning, a middle, and an end.", "image": "1️⃣2️⃣3️⃣" },
        { "text": "First the seed is planted, then it grows, then it becomes a flower.", "example": "🌱 → 🌿 → 🌸" }
      ],
      "questions": [
        { "id": "q1", "prompt": "What comes FIRST when growing a plant?", "answerStyle": "text",
          "answers": [ {"id":"a","label":"Plant a seed","correct":true}, {"id":"b","label":"Pick the flower","correct":false} ] },
        { "id": "q2", "prompt": "Read a story's last part. That is the...", "answerStyle": "text",
          "answers": [ {"id":"a","label":"End","correct":true}, {"id":"b","label":"Beginning","correct":false}, {"id":"c","label":"Title","correct":false} ] },
        { "id": "q3", "prompt": "Order: wake up, eat breakfast. What is first?", "answerStyle": "text",
          "answers": [ {"id":"a","label":"Wake up","correct":true}, {"id":"b","label":"Eat breakfast","correct":false} ] }
      ]
    },
    {
      "id": "reading-g3-mainidea", "gradeBand": "g3", "title": "Main Idea",
      "objective": "I can find what a passage is mostly about.",
      "teach": [
        { "text": "The main idea is what the whole passage is MOSTLY about.", "image": "💡" },
        { "text": "Details are smaller facts that support the main idea.", "example": "Passage about bees pollinating flowers → main idea: bees help flowers." }
      ],
      "questions": [
        { "id": "q1", "prompt": "A passage describes a dog's ears, tail, and bark. It is mostly about...", "answerStyle": "text",
          "answers": [ {"id":"a","label":"A dog","correct":true}, {"id":"b","label":"A car","correct":false}, {"id":"c","label":"The weather","correct":false} ] },
        { "id": "q2", "prompt": "The 'main idea' is...", "answerStyle": "text",
          "answers": [ {"id":"a","label":"What it is mostly about","correct":true}, {"id":"b","label":"One small detail","correct":false} ] },
        { "id": "q3", "prompt": "Small facts that support the main idea are called...", "answerStyle": "text",
          "answers": [ {"id":"a","label":"Details","correct":true}, {"id":"b","label":"Titles","correct":false}, {"id":"c","label":"Covers","correct":false} ] }
      ]
    },
    {
      "id": "reading-k-directions",
      "gradeBand": "k",
      "title": "Following Directions",
      "objective": "I can follow simple directions I read or hear.",
      "teach": [
        {
          "text": "Reading helps us follow steps in order.",
          "image": "👣"
        },
        {
          "text": "First do step 1, then step 2.",
          "image": "1️⃣"
        }
      ],
      "questions": [
        {
          "id": "q1",
          "prompt": "It says: 'Touch your nose.' What do you touch?",
          "answerStyle": "text",
          "answers": [
            {
              "id": "a",
              "label": "Your nose",
              "correct": true
            },
            {
              "id": "b",
              "label": "Your toes",
              "correct": false
            }
          ]
        },
        {
          "id": "q2",
          "prompt": "It says: 'Clap two times.' How many claps?",
          "answerStyle": "text",
          "answers": [
            {
              "id": "a",
              "label": "2",
              "correct": true
            },
            {
              "id": "b",
              "label": "5",
              "correct": false
            }
          ]
        },
        {
          "id": "q3",
          "prompt": "What word means do it FIRST?",
          "answerStyle": "text",
          "answers": [
            {
              "id": "a",
              "label": "First",
              "correct": true
            },
            {
              "id": "b",
              "label": "Last",
              "correct": false
            },
            {
              "id": "c",
              "label": "Never",
              "correct": false
            }
          ]
        }
      ]
    },
    {
      "id": "reading-g1-setting",
      "gradeBand": "g1",
      "title": "Characters and Setting",
      "objective": "I can find who is in a story and where it happens.",
      "teach": [
        {
          "text": "Characters are WHO is in the story. The setting is WHERE it happens.",
          "image": "🏰"
        },
        {
          "text": "Read: 'Lily played at the beach.' Lily is the character; the beach is the setting.",
          "image": "🏖️"
        }
      ],
      "questions": [
        {
          "id": "q1",
          "prompt": "Read: 'Max slept in his bed.' Where is Max?",
          "answerStyle": "text",
          "answers": [
            {
              "id": "a",
              "label": "In bed",
              "correct": true
            },
            {
              "id": "b",
              "label": "At school",
              "correct": false
            }
          ]
        },
        {
          "id": "q2",
          "prompt": "Read: 'The fox ran in the forest.' Who is the character?",
          "answerStyle": "text",
          "answers": [
            {
              "id": "a",
              "label": "The fox",
              "correct": true
            },
            {
              "id": "b",
              "label": "A car",
              "correct": false
            }
          ]
        },
        {
          "id": "q3",
          "prompt": "The place a story happens is the...",
          "answerStyle": "text",
          "answers": [
            {
              "id": "a",
              "label": "Setting",
              "correct": true
            },
            {
              "id": "b",
              "label": "Title",
              "correct": false
            },
            {
              "id": "c",
              "label": "Cover",
              "correct": false
            }
          ]
        }
      ]
    },
    {
      "id": "reading-g2-predict",
      "gradeBand": "g2",
      "title": "Making Predictions",
      "objective": "I can guess what happens next using clues.",
      "teach": [
        {
          "text": "A prediction is a smart guess about what comes next.",
          "image": "🔮"
        },
        {
          "text": "If dark clouds roll in, you can predict it will rain.",
          "image": "🌧️"
        }
      ],
      "questions": [
        {
          "id": "q1",
          "prompt": "Clouds are dark and the wind blows. What will probably happen?",
          "answerStyle": "text",
          "answers": [
            {
              "id": "a",
              "label": "It will rain",
              "correct": true
            },
            {
              "id": "b",
              "label": "It will snow ice cream",
              "correct": false
            }
          ]
        },
        {
          "id": "q2",
          "prompt": "A kid is yawning in bed. What comes next?",
          "answerStyle": "text",
          "answers": [
            {
              "id": "a",
              "label": "They fall asleep",
              "correct": true
            },
            {
              "id": "b",
              "label": "They run a race",
              "correct": false
            }
          ]
        },
        {
          "id": "q3",
          "prompt": "A prediction is a...",
          "answerStyle": "text",
          "answers": [
            {
              "id": "a",
              "label": "Smart guess",
              "correct": true
            },
            {
              "id": "b",
              "label": "A title",
              "correct": false
            }
          ]
        }
      ]
    },
    {
      "id": "reading-g3-context",
      "gradeBand": "g3",
      "title": "Context Clues",
      "objective": "I can use a sentence to figure out a new word.",
      "teach": [
        {
          "text": "Context clues are other words that help you understand a new word.",
          "image": "🔎"
        },
        {
          "text": "In 'The gigantic whale was huge,' nearby words tell you gigantic means very big."
        }
      ],
      "questions": [
        {
          "id": "q1",
          "prompt": "'The arid desert had no water.' Arid means...",
          "answerStyle": "text",
          "answers": [
            {
              "id": "a",
              "label": "Very dry",
              "correct": true
            },
            {
              "id": "b",
              "label": "Very wet",
              "correct": false
            }
          ]
        },
        {
          "id": "q2",
          "prompt": "'She was elated and jumped for joy.' Elated means...",
          "answerStyle": "text",
          "answers": [
            {
              "id": "a",
              "label": "Very happy",
              "correct": true
            },
            {
              "id": "b",
              "label": "Very tired",
              "correct": false
            }
          ]
        },
        {
          "id": "q3",
          "prompt": "Context clues are words that...",
          "answerStyle": "text",
          "answers": [
            {
              "id": "a",
              "label": "Help explain a new word",
              "correct": true
            },
            {
              "id": "b",
              "label": "Spell your name",
              "correct": false
            }
          ]
        }
      ]
    },
    {
      "id": "reading-g3-factopinion",
      "gradeBand": "g3",
      "title": "Fact or Opinion",
      "objective": "I can tell a fact from an opinion.",
      "teach": [
        {
          "text": "A fact is true and can be checked. An opinion is what someone feels.",
          "image": "⚖️"
        },
        {
          "text": "'The sky is blue' is a fact. 'Blue is the best color' is an opinion."
        }
      ],
      "questions": [
        {
          "id": "q1",
          "prompt": "Which is a FACT?",
          "answerStyle": "text",
          "answers": [
            {
              "id": "a",
              "label": "Earth has one moon",
              "correct": true
            },
            {
              "id": "b",
              "label": "Pizza is the yummiest food",
              "correct": false
            }
          ]
        },
        {
          "id": "q2",
          "prompt": "Which is an OPINION?",
          "answerStyle": "text",
          "answers": [
            {
              "id": "a",
              "label": "Recess is the most fun",
              "correct": true
            },
            {
              "id": "b",
              "label": "A week has 7 days",
              "correct": false
            }
          ]
        },
        {
          "id": "q3",
          "prompt": "Something you can prove true is a...",
          "answerStyle": "text",
          "answers": [
            {
              "id": "a",
              "label": "Fact",
              "correct": true
            },
            {
              "id": "b",
              "label": "Opinion",
              "correct": false
            }
          ]
        }
      ]
    },
    {
      "id": "reading-tod-match",
      "gradeBand": "toddler",
      "title": "Find the Match",
      "objective": "I can match pictures that are the same.",
      "teach": [
        {
          "text": "Matching means finding two that look the same.",
          "image": "🔍"
        },
        {
          "text": "Find the picture that matches!",
          "image": "👀"
        }
      ],
      "questions": [
        {
          "id": "q1",
          "prompt": "Which matches 🐶?",
          "answerStyle": "picture",
          "answers": [
            {
              "id": "a",
              "image": "🐶",
              "correct": true
            },
            {
              "id": "b",
              "image": "🐱",
              "correct": false
            }
          ]
        },
        {
          "id": "q2",
          "prompt": "Which matches ⭐?",
          "answerStyle": "picture",
          "answers": [
            {
              "id": "a",
              "image": "⭐",
              "correct": true
            },
            {
              "id": "b",
              "image": "❤️",
              "correct": false
            }
          ]
        },
        {
          "id": "q3",
          "prompt": "Which matches 🍌?",
          "answerStyle": "picture",
          "answers": [
            {
              "id": "a",
              "image": "🍌",
              "correct": true
            },
            {
              "id": "b",
              "image": "🍎",
              "correct": false
            }
          ]
        },
        {
          "id": "q4",
          "prompt": "Which matches 🚗?",
          "answerStyle": "picture",
          "answers": [
            {
              "id": "a",
              "image": "🚗",
              "correct": true
            },
            {
              "id": "b",
              "image": "✈️",
              "correct": false
            }
          ]
        }
      ]
    },
    {
      "id": "reading-g3-fiction",
      "gradeBand": "g3",
      "title": "Fiction and Nonfiction",
      "objective": "I can tell made-up stories from true facts.",
      "teach": [
        {
          "text": "Fiction is a made-up story. Nonfiction gives true facts.",
          "image": "📚"
        },
        {
          "text": "A talking dragon is fiction. A book about real sharks is nonfiction.",
          "image": "🐉"
        }
      ],
      "questions": [
        {
          "id": "q1",
          "prompt": "A story about a talking robot is...",
          "answerStyle": "text",
          "answers": [
            {
              "id": "a",
              "label": "Fiction",
              "correct": true
            },
            {
              "id": "b",
              "label": "Nonfiction",
              "correct": false
            }
          ]
        },
        {
          "id": "q2",
          "prompt": "A book of true facts about planets is...",
          "answerStyle": "text",
          "answers": [
            {
              "id": "a",
              "label": "Nonfiction",
              "correct": true
            },
            {
              "id": "b",
              "label": "Fiction",
              "correct": false
            }
          ]
        },
        {
          "id": "q3",
          "prompt": "Nonfiction is mostly...",
          "answerStyle": "text",
          "answers": [
            {
              "id": "a",
              "label": "True",
              "correct": true
            },
            {
              "id": "b",
              "label": "Made up",
              "correct": false
            }
          ]
        },
        {
          "id": "q4",
          "prompt": "A fairy tale is...",
          "answerStyle": "text",
          "answers": [
            {
              "id": "a",
              "label": "Fiction",
              "correct": true
            },
            {
              "id": "b",
              "label": "Nonfiction",
              "correct": false
            }
          ]
        }
      ]
    }
  ]
}
